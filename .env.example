# Copy to .env, or enter these in the console at http://127.0.0.1:8000/ → Connections.
# Anything set in the console is written to data/credentials.json and wins over this file.

# --- Lyric adaptation (pick one) ------------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- Stems and lyrics -----------------------------------------------------
MUSIC_AI_API_KEY=          # separation + sung-lyrics alignment
LALAL_API_KEY=             # separation
ELEVENLABS_API_KEY=        # word-timed transcription; spoken sections only for voice

# --- Voice ----------------------------------------------------------------
KITS_API_KEY=              # singing voice conversion

# --- Runtime --------------------------------------------------------------
SONGLOC_HOST=127.0.0.1
SONGLOC_PORT=8000
SONGLOC_DATA_DIR=

# Hold every language for human approval before rendering a vocal.
# Setting this to false is the single biggest quality risk in the system.
SONGLOC_REQUIRE_REVIEW=true

# Lines scoring below this are flagged for attention (0-1).
SONGLOC_FIT_THRESHOLD=0.75

# How many times the model may retry a line the scorer rejected.
SONGLOC_MAX_ADAPT_ROUNDS=3

SONGLOC_HTTP_TIMEOUT=600
